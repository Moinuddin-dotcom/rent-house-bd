# --- App ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://renthouse:renthouse@localhost:5432/renthouse?schema=public

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Seeded admin account (used by `npm run prisma:seed`) ---
ADMIN_EMAIL=admin@renthousebd.com
ADMIN_PASSWORD=ChangeMe123!

# --- AWS S3 (images + ownership documents) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=rent-house-bd-media
# Optional: public base URL for images (e.g. a CloudFront domain). Defaults to the bucket URL.
AWS_S3_PUBLIC_URL=

# --- YouTube (listing videos are uploaded to the platform channel as "unlisted") ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=unlisted
